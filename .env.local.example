# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (named AI_API_KEY to avoid env filtering in dev)
AI_API_KEY=

# GitHub — fine-grained PAT, Contents read/write on client repos
GITHUB_TOKEN=
GITHUB_ORG=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
# Optional: test-mode key for local end-to-end runs (see LAUNCH_TODOS)
STRIPE_SECRET_KEY_TEST=

# Twilio (inbound SMS/MMS webhook)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Set to true to bypass Twilio signature validation for local curl testing
MOCK_TWILIO=

# Resend (client email notifications)
RESEND_API_KEY=
EMAIL_FROM=RefreshWeb <notifications@refreshweb.io>
EMAIL_REPLY_TO=

# Admin
ADMIN_PASSWORD=

# Set to true to return canned Claude suggestions without API spend
MOCK_CLAUDE=
